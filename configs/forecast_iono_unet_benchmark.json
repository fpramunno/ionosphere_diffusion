{
    "model": {
        "type": "unet_simple",
        "in_channels": 1,
        "out_channels": 1,
        "input_size": [24, 360],
        "pred_frames": 7,
        "cond_frames": 15,
        "base_channels": 128,
        "channel_mults": [1, 2, 4, 4],
        "num_res_blocks": 2,
        "dropout_rate": 0.0,
        "has_variance": false,
        "loss_config": "karras",
        "loss_weighting": "soft-min-snr",
        "loss_scales": 1,
        "sigma_data": 0.5,
        "sigma_min": 0.01,
        "sigma_max": 100.0,
        "sigma_sample_density": {
            "type": "cosine-interpolated"
        }
    },
    "optimizer": {
        "type": "adamw",
        "lr": 1e-4,
        "betas": [0.95, 0.999],
        "eps": 1e-6,
        "weight_decay": 1e-3
    },
    "lr_sched": {
        "type": "cosine",
        "warmup_steps": 1000,
        "eta_min_factor": 1000
    },
    "ema_sched": {
        "type": "inverse",
        "power": 0.6667,
        "max_value": 0.9999
    }
}
